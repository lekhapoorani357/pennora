# ─────────────────────────────────────────────────────────────────────────────
# Pennora Backend — .dockerignore
# Prevents secrets, caches, local DBs, and test artefacts from entering image.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets (MUST NEVER be in image) ────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python bytecode & caches ─────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python

# ── Test infrastructure ───────────────────────────────────────────────────────
.pytest_cache/
**/.pytest_cache/
tests/
pytest.ini
setup.cfg
.coverage
htmlcov/
*.xml

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Local SQLite database (prod uses PostgreSQL via DATABASE_URL) ─────────────
*.db
*.db-shm
*.db-wal
goalsync.db
goalsync.db-shm
goalsync.db-wal

# ── Local ML model caches (sentence-transformers downloads at runtime) ────────
.cache/
**/.cache/
models/
sentence_transformers_cache/
faiss_index/
*.index

# ── Git ──────────────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── IDE / OS metadata ────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs & temp files ────────────────────────────────────────────────────────
*.log
tmp/
temp/

# ── Migration / one-off scripts ──────────────────────────────────────────────
migrate_to_postgres.py
drop_index.py
test_connection.py

# ── Docs ─────────────────────────────────────────────────────────────────────
README.md
