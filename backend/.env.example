# PostgreSQL / Supabase Connection URI
# Example Supabase Transaction Pooler URI (IPv4 compatible):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or Direct PostgreSQL URI:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your_db_password@your_supabase_host:5432/postgres

# JWT Authentication
JWT_SECRET=super-secret-key-change-this-in-production-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
